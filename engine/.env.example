# Betta Arena engine. Copy to engine/.env on the server. Never commit the real file.

PORT=5050
# Robinhood Chain mainnet. The public RPC is rate-limited: use a dedicated endpoint (Quicknode, Alchemy...) for launch.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
DATA_DIR=./data

# Empty = standby (the site shows its preview). Fill in after launching $BETTA on Pons.
TOKEN_ADDRESS=
# Optional: the block $BETTA was launched in (found automatically if empty)
START_BLOCK=

# The private key of the wallet that LAUNCHED $BETTA on Pons: the fee escrow pays that wallet.
# It claims the creator fees and buys back. Keep ~0.005 ETH on it for gas; it holds nothing else.
ENGINE_KEY=

# The bell rings when the fee escrow holds at least this much ETH
BUYBACK_STEP_ETH=0.02
# ETH the engine always keeps for its own gas
GAS_BUFFER_ETH=0.0008
# Most the buyback price may move against it before it is refused (basis points; 300 = 3%)
SLIPPAGE_BPS=300

# Smallest buy that throws a betta into the ring (whole tokens)
FIGHT_MIN_TOKENS=10000
SHELF_SIZE=10
SHELF_MIN_TOKENS=0
# Comma-separated: wallets that are never on the shelf (team, treasury...), and extra pools where selling happens
EXCLUDE=
SELL_SINKS=

# The site's address(es), comma separated (CORS for the API)
ALLOWED_ORIGINS=https://bettaarena.xyz

# Pons Family v2 on Robinhood Chain (from the palm engine). Only change them if Pons does.
PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
UNISWAP_ROUTER_ADDRESS=0x8876789976dEcBfCbBbe364623C63652db8C0904
