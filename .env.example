# Site settings. Copy to .env (or set them in your host) and rebuild.

# The engine's API. Empty = the same site (/api, as with the nginx setup in docs/DEPLOY.md).
# On a separate host use its full address, e.g. https://api.bettaarena.xyz
VITE_API_URL=""
# Dev only: proxy /api to a locally running engine (npm run dev). Leave empty to see the demo.
ENGINE_URL=""
VITE_EXPLORER_URL="https://robinhoodchain.blockscout.com"

# $BETTA on Robinhood Chain (shown on the page; empty until launch)
VITE_TOKEN_ADDRESS=""
VITE_TOKEN_SYMBOL="BETTA"

# Links (empty = hidden or "Coming soon")
VITE_LINK_BUY=""          # the token's page on Pons
VITE_LINK_X=""
VITE_LINK_DEXSCREENER=""
VITE_LINK_DOCS=""
