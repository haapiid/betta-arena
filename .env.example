# Web app settings. Copy to .env (or set them in your hosting dashboard) and rebuild.
# The contract addresses and schedule are printed by contracts/scripts/deploy.ts.

# Robinhood Chain mainnet = 4663, testnet = 46630
VITE_CHAIN_ID="4663"
# Public RPC is rate-limited; a dedicated endpoint (e.g. Quicknode, Alchemy) is better for launch
VITE_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
VITE_EXPLORER_URL="https://robinhoodchain.blockscout.com"
# The game server (server/), e.g. https://api.bettaarena.xyz
VITE_API_URL=""

# Contracts. Until all four are set the site shows "Launching soon" and nothing can be bought.
VITE_TOKEN_ADDRESS=""
VITE_FISH_ADDRESS=""
VITE_SHOP_ADDRESS=""
VITE_ARENA_ADDRESS=""
VITE_TOKEN_SYMBOL="BETTA"

# Must match the arena contract (the deploy script prints both)
VITE_SEASON_START=""
VITE_TOURNAMENT_DAYS="3"

# Fish lifespan in days and care speed (1 = real time). Must match the server's values.
VITE_LIFESPAN_DAYS="60"
VITE_CARE_SPEED="1"

# Community links (empty = "Coming soon" on /community)
VITE_LINK_X=""
VITE_LINK_TELEGRAM=""
VITE_LINK_DISCORD=""
VITE_LINK_DEXSCREENER=""
VITE_LINK_BUY=""
VITE_LINK_DOCS=""
