# Coin ticker shown in the UI
VITE_TOKEN_SYMBOL="BETTA"
# Ethereum chain id for the wallet (1 = mainnet, 11155111 = Sepolia testnet)
VITE_CHAIN_ID="1"
# ERC-20 token contract address, 0x... (leave empty before launch)
VITE_TOKEN_ADDRESS=""
# A tournament round runs every N days (decimals allowed, e.g. 0.5 = every 12 hours)
VITE_TOURNAMENT_DAYS="3"
# Lifespan of a fish in days (Juvenile → Adult → Prime → Senior → old age)
VITE_LIFESPAN_DAYS="60"
# Fill empty tournament slots with NPC fish. Keep this true until a server or contract collects entries
# from every wallet: with false, a browser only ever sees its own (max 3) fish, so every round is
# called off for having fewer than 4 entrants.
VITE_NPC_FILL="true"
# Show demo controls (coin faucet, "ring the bell now", reset). Off unless set to true; keep it off for launch.
VITE_DEMO_MODE="true"
# Speed up hunger, water, ageing and training cooldowns for testing (1 = real time)
VITE_CARE_SPEED="1"
# Community links (empty = "Coming soon" on the /community page)
VITE_LINK_X=""
VITE_LINK_TELEGRAM=""
VITE_LINK_DISCORD=""
VITE_LINK_DEXSCREENER=""
VITE_LINK_BUY=""
VITE_LINK_DOCS=""
