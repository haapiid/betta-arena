# Game server settings. Copy to server/.env (or set them on your host). Never commit the real file.

PORT=8787
# Postgres (Neon, Supabase, Railway...). Empty = embedded database in DATA_DIR (single machine with a disk).
DATABASE_URL=
DATA_DIR=./data

# Robinhood Chain: mainnet 4663, testnet 46630. Use a dedicated RPC for production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# From contracts/scripts/deploy.ts
TOKEN_ADDRESS=
FISH_ADDRESS=
SHOP_ADDRESS=
ARENA_ADDRESS=
START_BLOCK=0

# Private key whose address was set as `signer` in the contracts. It signs fish snapshots and shop
# permits; it never holds funds. Generate a fresh key just for this.
SIGNER_KEY=
# Private key of the `operator` wallet: commits, reveals and settles rounds. Keep ~0.01 ETH on it for gas.
OPERATOR_KEY=
# Long random string. The round secrets are derived from it, so keep it private and never change it mid-season.
OPERATOR_SECRET=
# Long random string for login sessions
SESSION_SECRET=

# The web app's address(es), comma separated (used for CORS and to check sign-in messages)
ALLOWED_ORIGINS=https://bettaarena.xyz
# This server's public address (NFT metadata lives at PUBLIC_URL/api/fish/<id>)
PUBLIC_URL=https://api.bettaarena.xyz
POLL_MS=4000
RUN_OPERATOR=true

# Must match the web app
VITE_LIFESPAN_DAYS=60
VITE_CARE_SPEED=1
