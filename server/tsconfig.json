{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src",
    "../src/game",
    "../src/chain",
    "../src/config.ts",
    "../src/render/color.ts"
  ],
  "exclude": [
    "../src/game/store.ts",
    "../src/game/leaderboard.ts"
  ]
}